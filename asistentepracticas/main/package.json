{
  "functions": [
    {
      "source": "main",
      "codebase": "api"
    }
  ],
  "hosting": {
    "site": "asistentep-9f276",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api{,/**}",
        "run": {
          "serviceId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-functions": "^6.6.0",
    "openai": "^6.7.0"
  }
}

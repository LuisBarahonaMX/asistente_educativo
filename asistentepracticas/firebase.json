{
  "functions": [
    {
      "source": "main",
      "codebase": "api",
      "runtime": "nodejs20"
    }
  ],
  "hosting": {
    "site": "asistentep-9f276",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api{,/**}",
        "run": {
          "serviceId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
